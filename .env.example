# =============================================================================
# Configuration Docker — IPF (5 Secondes Chrono)
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env
# =============================================================================

# =====================
# PostgreSQL
# =====================
POSTGRES_USER=ipf_admin
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=ipf_db
POSTGRES_PORT=5432

# =====================
# Redis
# =====================
REDIS_PORT=6379

# =====================
# API NestJS
# =====================
API_PORT=3000

# =====================
# Web App Next.js
# =====================
WEB_APP_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# =====================
# Auth0 (obligatoire)
# =====================
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.ipf.local
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=your-secret-key
AUTH0_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3001

# =====================
# pgAdmin (profil tools)
# =====================
PGADMIN_EMAIL=admin@ipf.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# =====================
# Redis Commander (profil tools)
# =====================
REDIS_COMMANDER_PORT=8081
