# =============================================================================
# Dockerfile.dev - Web Admin (Vite React)
# Mode developpement avec hot-reload
# =============================================================================

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./

RUN npm ci

EXPOSE 5173

ENV NODE_ENV=development
ENV PORT=5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
