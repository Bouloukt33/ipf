# Auth0 Configuration
# Remplacez par vos valeurs depuis le dashboard Auth0
AUTH0_DOMAIN=votre-tenant.auth0.com
AUTH0_AUDIENCE=https://api.ipf.com
AUTH0_CLIENT_ID=votre-client-id
AUTH0_CONNECTION=Username-Password-Authentication

# Application
PORT=3000
NODE_ENV=development

# Database (si vous utilisez Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ipf_db"

# Redis (pour le cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (nodemailer) — voir CONFIGURATION.md pour les options SendGrid / Resend / Gmail
# Sans ces vars, les emails sont loggés en console (pas de plantage)
MAILER_HOST=smtp.sendgrid.net
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=apikey
MAILER_PASS=SG.votre-cle-sendgrid
MAILER_FROM="5 Secondes Chrono <noreply@ipf.com>"

# Stripe
# Mode simulation : aucune clé requise, les abonnements sont activés directement en base.
# Mettre STRIPE_SIMULATION_MODE=false et renseigner les clés ci-dessous pour utiliser Stripe (mode test ou live).
STRIPE_SIMULATION_MODE=true
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID_APPRENTI=price_xxx
# STRIPE_PRICE_ID_COMPAGNON=price_xxx
# STRIPE_PRICE_ID_REUSSITE=price_xxx

# URL du frontend (redirection après paiement Stripe)
FRONTEND_URL=http://localhost:3001
