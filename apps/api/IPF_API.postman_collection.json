{
  "info": {
    "name": "IPF - 5 Secondes Chrono API",
    "description": "Collection Postman pour tester l'API du projet IPF avec Auth0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "IPF Team"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth0_domain",
      "value": "ipf-5secondes-dev.eu.auth0.com",
      "type": "string"
    },
    {
      "key": "auth0_client_id",
      "value": "VOTRE_CLIENT_ID",
      "type": "string"
    },
    {
      "key": "auth0_client_secret",
      "value": "VOTRE_CLIENT_SECRET",
      "type": "string"
    },
    {
      "key": "auth0_audience",
      "value": "https://api.ipf.local",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Get Access Token (M2M)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('Token saved:', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{auth0_client_id}}\",\n  \"client_secret\": \"{{auth0_client_secret}}\",\n  \"audience\": \"{{auth0_audience}}\",\n  \"grant_type\": \"client_credentials\"\n}"
            },
            "url": {
              "raw": "https://{{auth0_domain}}/oauth/token",
              "protocol": "https",
              "host": ["{{auth0_domain}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "Health Check (Public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            }
          }
        },
        {
          "name": "Protected Route Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": ["{{base_url}}"],
              "path": ["protected"]
            }
          }
        },
        {
          "name": "Register / Sync User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Mon Pseudo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Sync User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.user) {",
                  "        pm.collectionVariables.set('user_id', jsonData.user.id);",
                  "        console.log('User ID saved:', jsonData.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get My Info (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Check Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/check",
              "host": ["{{base_url}}"],
              "path": ["auth", "check"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Delete Account ⚠️",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/account",
              "host": ["{{base_url}}"],
              "path": ["auth", "account"]
            }
          }
        }
      ]
    },
    {
      "name": "👤 Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": ["{{base_url}}"],
              "path": ["profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"John Doe\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile",
              "host": ["{{base_url}}"],
              "path": ["profile"]
            }
          }
        },
        {
          "name": "Get My Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/stats",
              "host": ["{{base_url}}"],
              "path": ["profile", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "🎮 Quiz",
      "item": [
        {
          "name": "Start Quiz Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('session_id', jsonData.session.id);",
                  "    pm.collectionVariables.set('question_id', jsonData.questions[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"PRACTICE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/quiz/start",
              "host": ["{{base_url}}"],
              "path": ["quiz", "start"]
            }
          }
        },
        {
          "name": "Submit Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{session_id}}\",\n  \"questionId\": \"{{question_id}}\",\n  \"answer\": \"A\",\n  \"responseTimeMs\": 3500\n}"
            },
            "url": {
              "raw": "{{base_url}}/quiz/answer",
              "host": ["{{base_url}}"],
              "path": ["quiz", "answer"]
            }
          }
        },
        {
          "name": "Complete Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quiz/{{session_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["quiz", "{{session_id}}", "complete"]
            }
          }
        },
        {
          "name": "Get Quiz History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quiz/history?limit=10",
              "host": ["{{base_url}}"],
              "path": ["quiz", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "❓ Questions",
      "item": [
        {
          "name": "Get All Questions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["questions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "categoryId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "level",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "isPremium",
                  "value": "false",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Question by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Create Question (Admin/Moderator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"clx1234567890\",\n  \"text\": \"Quelle est la durée maximale d'un bail commercial ?\",\n  \"optionA\": \"6 ans\",\n  \"optionB\": \"9 ans\",\n  \"optionC\": \"12 ans\",\n  \"optionD\": \"15 ans\",\n  \"correctAnswer\": \"B\",\n  \"level\": 1,\n  \"isPremium\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/questions",
              "host": ["{{base_url}}"],
              "path": ["questions"]
            }
          }
        },
        {
          "name": "Update Question (Admin/Moderator)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Question mise à jour\",\n  \"level\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Delete Question (Admin/Moderator)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Toggle Question Active",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}/toggle-active",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}", "toggle-active"]
            }
          }
        }
      ]
    },
    {
      "name": "📚 Categories",
      "item": [
        {
          "name": "Get All Categories (Public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["categories", "{{category_id}}"]
            }
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/slug/baux-commerciaux",
              "host": ["{{base_url}}"],
              "path": ["categories", "slug", "baux-commerciaux"]
            }
          }
        },
        {
          "name": "Get Category Themes",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}/themes",
              "host": ["{{base_url}}"],
              "path": ["categories", "{{category_id}}", "themes"]
            }
          }
        }
      ]
    },
    {
      "name": "👥 Users (Admin)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "USER",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "john",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get User Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/stats",
              "host": ["{{base_url}}"],
              "path": ["users", "stats"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MODERATOR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/role",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "role"]
            }
          }
        },
        {
          "name": "Toggle User Active",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/toggle-active",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "toggle-active"]
            }
          }
        },
        {
          "name": "Ban User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/ban",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "ban"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Admin Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/dashboard",
              "host": ["{{base_url}}"],
              "path": ["admin", "dashboard"]
            }
          }
        },
        {
          "name": "Get Recent Activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/activity",
              "host": ["{{base_url}}"],
              "path": ["admin", "activity"]
            }
          }
        },
        {
          "name": "Get Questions Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/questions/stats",
              "host": ["{{base_url}}"],
              "path": ["admin", "questions", "stats"]
            }
          }
        }
      ]
    }
  ]
}
