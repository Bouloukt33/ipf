# =============================================================================
# Dockerfile.dev - API NestJS (IPF - 5 Secondes Chrono)
# Mode développement avec hot-reload (ts-node / nest start --watch)
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Installer les dépendances système utiles pour le dev
RUN apk add --no-cache libc6-compat openssl

# Copier les fichiers de dépendances et le schéma Prisma
COPY package.json package-lock.json* ./
COPY prisma ./prisma/

# Installer toutes les dépendances (dev incluses)
RUN npm ci

# Générer le client Prisma
RUN npx prisma generate

# Le code source est monté via volume dans docker-compose
# On ne COPY pas le code ici

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000

# nest start --watch pour le hot-reload TypeScript
CMD ["npm", "run", "start:dev"]