# =============================================================================
# Dockerfile.dev - API NestJS (IPF - 5 Secondes Chrono)
# Hot-reload — contexte de build = RACINE du monorepo (npm workspaces)
# Le code source est monté via volume dans docker-compose (voir profil "dev")
# =============================================================================

FROM node:20-alpine

WORKDIR /repo

RUN apk add --no-cache libc6-compat openssl

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma/
COPY apps/api/prisma.config.ts apps/api/

# Installe toutes les deps (dev incluses) ; le postinstall génère le client
# Prisma dans /repo/node_modules/.prisma/client
RUN npm ci --workspace=api

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000

# nest start --watch pour le hot-reload TypeScript
CMD ["npm", "run", "start:dev", "--workspace=api"]
