// ============================================================================
// 🎮 IPF "5 Secondes Chrono" - Schéma Prisma Complet
// ============================================================================
// Dernière mise à jour: 2026-01-13
// Tables: 18 (Users, Questions, Quiz, IA, Gamification, Abonnements)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 👤 UTILISATEUR & AUTHENTIFICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  auth0Id       String    @unique @map("auth0_id")
  email         String    @unique
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profile          UserProfile?
  ranking          UserRanking?
  userBadges       UserBadge[]
  quizSessions     QuizSession[]
  userMasteries    UserMastery[]
  aiRecommendations AiRecommendation[]
  subscription     Subscription?
  leaderboardEntries LeaderboardEntry[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// ============================================================================
// 🎮 GAMIFICATION - PROFIL & PROGRESSION
// ============================================================================

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  xpTotal       Int       @default(0) @map("xp_total")
  level         Int       @default(1)
  streakDays    Int       @default(0) @map("streak_days")
  bestStreak    Int       @default(0) @map("best_streak")
  lastPlayedAt  DateTime? @map("last_played_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserRanking {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  eloScore      Int       @default(1200) @map("elo_score")
  globalRank    Int?      @map("global_rank")
  weeklyRank    Int?      @map("weekly_rank")
  monthlyRank   Int?      @map("monthly_rank")
  totalGames    Int       @default(0) @map("total_games")
  totalWins     Int       @default(0) @map("total_wins")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rankings")
}

// ============================================================================
// 🏆 BADGES & ACHIEVEMENTS
// ============================================================================

model Badge {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String
  iconUrl         String?   @map("icon_url")
  conditionType   BadgeConditionType @map("condition_type")
  conditionValue  Int       @map("condition_value")
  xpReward        Int       @default(50) @map("xp_reward")
  isSecret        Boolean   @default(false) @map("is_secret")
  order           Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  userBadges UserBadge[]

  @@map("badges")
}

enum BadgeConditionType {
  FIRST_SESSION       // Premier quiz terminé
  STREAK_DAYS         // X jours consécutifs
  CORRECT_STREAK      // X bonnes réponses consécutives
  CATEGORY_MASTERY    // 80% maîtrise catégorie
  FAST_ANSWER         // Réponse en moins de X secondes
  TOP_RANK            // Top X classement
  WEEKLY_CHAMPION     // 1ère place semaine
  TOTAL_XP            // X XP total
  TOTAL_QUESTIONS     // X questions répondues
  PERFECT_SESSION     // Session 100% correcte
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  badgeId     String    @map("badge_id")
  unlockedAt  DateTime  @default(now()) @map("unlocked_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ============================================================================
// 📚 CATÉGORIES & THÈMES (6 Types de Baux)
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  iconUrl     String?   @map("icon_url")
  color       String?   // Couleur HEX pour l'UI
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  themes        Theme[]
  questions     Question[]
  packs         Pack[]
  videos        Video[]
  userMasteries UserMastery[]
  leaderboards  Leaderboard[]
  aiRecommendations AiRecommendation[]

  @@map("categories")
}

model Theme {
  id          String    @id @default(cuid())
  categoryId  String    @map("category_id")
  name        String
  slug        String
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions     Question[]
  userMasteries UserMastery[]
  aiRecommendations AiRecommendation[]

  @@unique([categoryId, slug])
  @@map("themes")
}

// ============================================================================
// ❓ QUESTIONS & CONTENU PÉDAGOGIQUE
// ============================================================================

model Question {
  id              String    @id @default(cuid())
  categoryId      String    @map("category_id")
  themeId         String?   @map("theme_id")
  packId          String?   @map("pack_id")
  
  // Contenu de la question
  text            String
  optionA         String    @map("option_a")
  optionB         String    @map("option_b")
  optionC         String    @map("option_c")
  optionD         String    @map("option_d")
  correctAnswer   String    @map("correct_answer") // A, B, C ou D
  
  // Métadonnées
  level           Int       @default(1) // 1, 2, 3 (difficulté)
  timeToRead      Int?      @map("time_to_read") // Temps de lecture en secondes
  isPremium       Boolean   @default(false) @map("is_premium")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Source (pour traçabilité de l'import)
  sourceFile      String?   @map("source_file")
  sourceId        String?   @map("source_id")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  theme             Theme?   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  pack              Pack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  pedagogicalContent PedagogicalContent?
  questionStats     QuestionStats?
  quizAnswers       QuizAnswer[]
  aiQuestionLogs    AiQuestionLog[]
  video             Video?   @relation(fields: [videoId], references: [id])
  videoId           String?  @map("video_id")

  @@index([categoryId])
  @@index([themeId])
  @@index([level])
  @@index([isPremium])
  @@map("questions")
}

model PedagogicalContent {
  id              String    @id @default(cuid())
  questionId      String    @unique @map("question_id")
  
  // Contenu pédagogique (extrait des DOCX)
  subject         String?   // Sujet/thème
  keyMessage      String?   @map("key_message") // Message clé mémorable
  essentialPoints Json?     @map("essential_points") // Points essentiels (array)
  examples        Json?     // Exemples concrets (array)
  trapToAvoid     String?   @map("trap_to_avoid") // Piège à éviter
  practicalAdvice String?   @map("practical_advice") // Conseil pratique
  synthesis       String?   // Synthèse
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("pedagogical_contents")
}

model Pack {
  id          String    @id @default(cuid())
  categoryId  String    @map("category_id")
  name        String
  slug        String
  description String?
  price       Decimal?  @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([categoryId, slug])
  @@map("packs")
}

model Video {
  id              String    @id @default(cuid())
  categoryId      String?   @map("category_id")
  title           String
  description     String?
  url             String
  durationSeconds Int?      @map("duration_seconds")
  thumbnailUrl    String?   @map("thumbnail_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questions Question[]

  @@map("videos")
}

// ============================================================================
// 🎯 QUIZ & SESSIONS DE JEU
// ============================================================================

model QuizSession {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  categoryId      String?     @map("category_id")
  mode            QuizMode    @default(PRACTICE)
  
  // Résultats
  score           Int         @default(0)
  totalQuestions  Int         @map("total_questions")
  correctAnswers  Int         @default(0) @map("correct_answers")
  xpEarned        Int         @default(0) @map("xp_earned")
  durationMs      Int?        @map("duration_ms")
  
  // Statut
  status          SessionStatus @default(IN_PROGRESS)
  startedAt       DateTime    @default(now()) @map("started_at")
  completedAt     DateTime?   @map("completed_at")

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
  aiQuestionLogs AiQuestionLog[]

  @@index([userId])
  @@index([status])
  @@map("quiz_sessions")
}

enum QuizMode {
  PRACTICE    // Entraînement libre
  RANKED      // Classé (affecte ELO)
  CHALLENGE   // Défi contre autre joueur
  DAILY       // Quiz du jour
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model QuizAnswer {
  id              String    @id @default(cuid())
  sessionId       String    @map("session_id")
  questionId      String    @map("question_id")
  userAnswer      String    @map("user_answer") // A, B, C, D ou null (timeout)
  isCorrect       Boolean   @map("is_correct")
  responseTimeMs  Int       @map("response_time_ms")
  xpEarned        Int       @default(0) @map("xp_earned")
  answeredAt      DateTime  @default(now()) @map("answered_at")

  // Relations
  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@map("quiz_answers")
}

// ============================================================================
// 🤖 IA ADAPTATIVE
// ============================================================================

model UserMastery {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  categoryId      String    @map("category_id")
  themeId         String?   @map("theme_id")
  
  masteryLevel    Float     @default(0) @map("mastery_level") // 0-100
  questionsSeen   Int       @default(0) @map("questions_seen")
  correctCount    Int       @default(0) @map("correct_count")
  lastPracticedAt DateTime? @map("last_practiced_at")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  theme    Theme?   @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@unique([userId, categoryId, themeId])
  @@index([userId])
  @@map("user_masteries")
}

model QuestionStats {
  id                  String    @id @default(cuid())
  questionId          String    @unique @map("question_id")
  totalAttempts       Int       @default(0) @map("total_attempts")
  correctAttempts     Int       @default(0) @map("correct_attempts")
  avgResponseTimeMs   Float?    @map("avg_response_time_ms")
  difficultyComputed  Float?    @map("difficulty_computed") // Calculée dynamiquement
  lastUpdatedAt       DateTime  @default(now()) @map("last_updated_at")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_stats")
}

model AiQuestionLog {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  questionId        String    @map("question_id")
  selectionReason   String    @map("selection_reason") // Raison du choix IA
  userMasteryAtTime Float?    @map("user_mastery_at_time")
  difficultyAtTime  Float?    @map("difficulty_at_time")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_question_logs")
}

model AiRecommendation {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  type        RecommendationType
  categoryId  String?             @map("category_id")
  themeId     String?             @map("theme_id")
  priority    Int                 @default(0)
  message     String?
  isRead      Boolean             @default(false) @map("is_read")
  createdAt   DateTime            @default(now()) @map("created_at")
  expiresAt   DateTime?           @map("expires_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  theme    Theme?    @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("ai_recommendations")
}

enum RecommendationType {
  WEAK_AREA     // Zone faible à travailler
  REVIEW        // Révision espacée
  CHALLENGE     // Défi de niveau supérieur
  STREAK_RISK   // Risque de perdre le streak
  NEW_CONTENT   // Nouveau contenu disponible
}

// ============================================================================
// 🏆 CLASSEMENTS (LEADERBOARDS)
// ============================================================================

model Leaderboard {
  id          String          @id @default(cuid())
  type        LeaderboardType
  categoryId  String?         @map("category_id")
  periodStart DateTime?       @map("period_start")
  periodEnd   DateTime?       @map("period_end")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries  LeaderboardEntry[]

  @@index([type, isActive])
  @@map("leaderboards")
}

enum LeaderboardType {
  GLOBAL
  CATEGORY
  WEEKLY
  MONTHLY
  DAILY
}

model LeaderboardEntry {
  id            String    @id @default(cuid())
  leaderboardId String    @map("leaderboard_id")
  userId        String    @map("user_id")
  score         Int
  rank          Int
  updatedAt     DateTime  @default(now()) @map("updated_at")

  // Relations
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
  @@index([leaderboardId, rank])
  @@map("leaderboard_entries")
}

// ============================================================================
// 💳 ABONNEMENTS & PAIEMENTS
// ============================================================================

model Plan {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  currency        String    @default("EUR")
  intervalMonths  Int       @default(1) @map("interval_months")
  features        Json?     // Liste des fonctionnalités
  stripePriceId   String?   @unique @map("stripe_price_id")
  isActive        Boolean   @default(true) @map("is_active")
  order           Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String            @id @default(cuid())
  userId              String            @unique @map("user_id")
  planId              String            @map("plan_id")
  status              SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  stripeCustomerId    String?           @map("stripe_customer_id")
  currentPeriodStart  DateTime          @map("current_period_start")
  currentPeriodEnd    DateTime          @map("current_period_end")
  cancelAtPeriodEnd   Boolean           @default(false) @map("cancel_at_period_end")
  canceledAt          DateTime?         @map("canceled_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}
