{
  "name": "ipf",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:web": "npm run dev --workspace=web-app",
    "dev:admin": "npm run dev --workspace=web-admin",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:landing": "npm run dev --workspace=landing",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "browser-tabs-lock@1.3.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
