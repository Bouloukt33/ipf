{
  "name": "@ipf/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types et constantes de domaine partagés entre les apps IPF",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
